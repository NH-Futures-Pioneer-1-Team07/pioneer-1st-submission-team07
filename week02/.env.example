# 과제 실행 환경: NH선물 국내 모의투자
TRADING_ENV=mock

# NH선물 국내 모의투자 인증정보: 로컬 backend/.env에만 입력
NH_APP_KEY=
NH_APP_SECRET=

# 전략·실행 기록 경로: 생략 시 backend/strategies, backend/runs 사용
# STRATEGIES_DIR=strategies
# RUNS_DIR=runs

# 백테스트 비용 가정: 수수료 0.0085%, 슬리피지 1틱
BACKTEST_FEE_RATE=0.000085
BACKTEST_SLIPPAGE_TICKS=1

# 과제 실행 환경: NH선물 모의투자 (해외 전략은 해외 모의투자 키 필요)
TRADING_ENV=mock

# 국내 모의투자 키 (국내 시세·VIX 외 국내 기능에만 사용. 3주차 전략은 해외 키만으로 동작)
# NH_APP_KEY=
# NH_APP_SECRET=

# 해외(CME 등) 전용 키. 해외 API는 국내 키로 호출할 수 없음(EGW016). 로컬 backend/.env에만 입력
NH_OVERSEAS_APP_KEY=
NH_OVERSEAS_APP_SECRET=

# 전략·실행 기록 경로: 생략 시 backend/strategies, backend/runs 사용
STRATEGIES_DIR=strategies
RUNS_DIR=runs

# 백테스트 비용 가정: 수수료 0.0085%, 슬리피지 1틱
BACKTEST_FEE_RATE=0.000085
BACKTEST_SLIPPAGE_TICKS=1
